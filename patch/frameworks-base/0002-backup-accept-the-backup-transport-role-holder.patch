+    private boolean isBackupTransportRoleHolder(ComponentName transport) {
+        RoleManager roleManager = mContext.getSystemService(RoleManager.class);
+        if (roleManager == null) {
+            return false;
+        }
+        return roleManager.getRoleHoldersAsUser(RoleManager.ROLE_BACKUP_TRANSPORT,
+                UserHandle.of(mUserId)).contains(transport.getPackageName());
+    }
