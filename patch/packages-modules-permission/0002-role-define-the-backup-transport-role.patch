     <string name="request_location_button_permissions_dialog_subtitle">When you share, this app will have access to precise location until you close the app</string>
 
     <!-- END LOCATION BUTTON GRANT DIALOG -->
+
+    <!-- Backup transport role -->
+    <string name="role_backup_transport_label">Backup app</string>
+    <string name="role_backup_transport_short_label">Backup</string>
+    <string name="role_backup_transport_description">Apps that can back up your device data</string>
+    <string name="role_backup_transport_request_title">Set <xliff:g id="app_name" example="Backup">%1$s</xliff:g> as your backup app?</string>
+    <string name="role_backup_transport_request_description">This app will be able to read and store the data of apps that allow backup, including SMS, call log and contacts where the system includes them.</string>
+    <string name="role_backup_transport_search_keywords">backup,restore</string>
 </resources>
diff --git a/PermissionController/res/xml/roles.xml b/PermissionController/res/xml/roles.xml
index dadfd1bf3a..e893f7f262 100644
--- a/PermissionController/res/xml/roles.xml
+++ b/PermissionController/res/xml/roles.xml
@@ -2178,4 +2178,32 @@
             <permission name="android.permission.SET_TIME_ZONE" />
         </permissions>
     </role>
+    <!--
+        A role for the system backup transport.
+
+        The role holder is used as the backup transport and is granted the BACKUP permission.
+        It must declare a service with an intent filter for android.backup.TRANSPORT_HOST.
+    -->
+    <role
+        name="android.app.role.BACKUP_TRANSPORT"
+        behavior="BackupTransportRoleBehavior"
+        description="@string/role_backup_transport_description"
+        exclusive="true"
+        exclusivity="user"
+        label="@string/role_backup_transport_label"
+        requestDescription="@string/role_backup_transport_request_description"
+        requestTitle="@string/role_backup_transport_request_title"
+        searchKeywords="@string/role_backup_transport_search_keywords"
+        shortLabel="@string/role_backup_transport_short_label">
+        <required-components>
+            <service>
+                <intent-filter>
+                    <action name="android.backup.TRANSPORT_HOST" />
+                </intent-filter>
+            </service>
+        </required-components>
+        <permissions>
+            <permission name="android.permission.BACKUP" />
+        </permissions>
+    </role>
 </roles>
